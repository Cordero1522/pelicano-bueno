---
import { formatDate } from '../lib/formatDate';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection, getEntry } from 'astro:content';

const notas = await getCollection('notas');
const notasOrdenadas = notas.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const notaPrincipal = notasOrdenadas[0];
const notasSidebar = notasOrdenadas.slice(1, 3);

const autorPrincipal = await getEntry(notaPrincipal.data.author);
const notasSidebarConAutor = await Promise.all(
  notasSidebar.map(async (nota) => ({
    nota,
    autor: await getEntry(nota.data.author),
  }))
);
---
<BaseLayout title="Pelícano Bueno · Evangelización Digital">
    <SiteHeader />
    <SiteNav />

    <main class="container" style="padding-top: 2rem; padding-bottom: 2rem;">
        <div class="row g-4">
                        <div class="col-lg-8">
                <article class="card-article">
                    <img src={notaPrincipal.data.image} alt={notaPrincipal.data.title} class="card-img" />
                    <span class="badge-cat">{notaPrincipal.data.category}</span>
                    <h1 class="card-title" style="font-size: 2rem;">{notaPrincipal.data.title}</h1>
                    <p class="card-subtitle">
                        <i class="bi bi-calendar-fill"></i> {formatDate(notaPrincipal.data.date)} · <strong>{autorPrincipal.data.name}</strong>
                    </p>
                    <p class="card-text">
                        {notaPrincipal.data.excerpt}
                    </p>
                    <a href={`/notas/${notaPrincipal.id}/`} class="btn-outline-dark-custom">
                        Leer más <i class="bi bi-caret-right-fill"></i>
                    </a>
                </article>
            </div>

                        <div class="col-lg-4">
                <div class="sidebar-notes">
                    {notasSidebarConAutor.map(({ nota, autor }) => (
    <article class="card-article sidebar-note">
        <img src={nota.data.image} alt={nota.data.title} class="card-img sidebar-note-img" />
        <span class="badge-cat">{nota.data.category}</span>
        <h4 class="card-title sidebar-note-title">{nota.data.title}</h4>
        <p class="card-subtitle">
            <i class="bi bi-calendar-fill"></i> {formatDate(nota.data.date)} · <strong>{autor.data.name}</strong>
        </p>
        <p class="card-text sidebar-note-text">{nota.data.excerpt}</p>
        <a href={`/notas/${nota.id}/`} class="btn-outline-dark-custom sidebar-note-btn">Leer más <i class="bi bi-caret-right-fill"></i></a>
    </article>
))}
                </div>
            </div>
        </div>
    </main>

    <SiteFooter />

    <script>
        import '../scripts/date.ts';
        import '../scripts/nav.ts';
    </script>
</BaseLayout>