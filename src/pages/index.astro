---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const notas = await getCollection('notas');

// Orden descendente por fecha: la más reciente primero
const notasOrdenadas = notas.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const notaPrincipal = notasOrdenadas[0];
const notasSidebar = notasOrdenadas.slice(1, 3); // las siguientes 2
---

<BaseLayout title="Pelícano Bueno · Evangelización Digital">

    <div class="top-bar">
        <div class="container">
            <div id="fecha-actual">
                <i class="bi bi-calendar-fill"></i>
                <span id="fecha-hoy"></span>
            </div>
        </div>
    </div>

    <header class="main-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <a href="/" class="logo">
                        Pelícano Bueno
                        <small>Evangelización Digital · 2026</small>
                    </a>
                </div>
                <div class="col-md-4 header-right">
                    <div class="social-icons-header">
                        <a href="#" target="_blank"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" target="_blank"><i class="bi bi-instagram"></i></a>
                        <a href="#" target="_blank"><i class="bi bi-facebook"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <nav class="nav-cats">
        <div class="container">
            <ul>
                <li><a href="/" class="active">INICIO</a></li>
                <li><a href="#">SANTA SEDE</a></li>
                <li><a href="#">FORMACIÓN</a></li>
                <li><a href="#">LITURGIA</a></li>
                <li><a href="#">BIBLIA</a></li>
                <li><a href="#">TEOLOGIA</a></li>
                <li><a href="#">SANTOS</a></li>
                <li><a href="#">REFLEXIONES</a></li>
            </ul>
        </div>
    </nav>

    <main class="container" style="padding-top: 2rem; padding-bottom: 2rem;">
        <div class="row g-4">
                        <div class="col-lg-8">
                <article class="card-article">
                    <img src="#" alt={notaPrincipal.data.title} class="card-img" />
                    <span class="badge-cat">{notaPrincipal.data.category}</span>
                    <h1 class="card-title" style="font-size: 2rem;">{notaPrincipal.data.title}</h1>
                    <p class="card-subtitle">
                        <i class="bi bi-calendar-fill"></i> {notaPrincipal.data.date.toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' })} · <strong>{notaPrincipal.data.author}</strong>
                    </p>
                    <p class="card-text">
                        {notaPrincipal.data.excerpt}
                    </p>
                    <a href={`/notas/${notaPrincipal.id}/`} class="btn-outline-dark-custom">
                        Leer más <i class="bi bi-caret-right-fill"></i>
                    </a>
                </article>
            </div>

                        <div class="col-lg-4">
                <div class="sidebar-notes">
                    {notasSidebar.map((nota) => (
                        <article class="card-article sidebar-note">
                            <img src="#" alt={nota.data.title} class="card-img sidebar-note-img" />
                            <span class="badge-cat">{nota.data.category}</span>
                            <h4 class="card-title sidebar-note-title">{nota.data.title}</h4>
                            <p class="card-text sidebar-note-text">{nota.data.excerpt}</p>
                            <a href={`/notas/${nota.id}/`} class="btn-outline-dark-custom sidebar-note-btn">Leer más <i class="bi bi-caret-right-fill"></i></a>
                        </article>
                    ))}
                </div>
            </div>
        </div>
    </main>

    <footer class="footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5>Pelícano Bueno</h5>
                    <p style="font-size:0.9rem;">Este es un sitio católico independiente, creado para ofrecer recursos que ayuden a conocer, profundizar y vivir la fe.</p>
                    <div class="social-icons">
                        <a href="https://x.com/?lang=es" target="_blank"><i class="bi bi-twitter-x"></i></a>
                        <a href="https://www.instagram.com/" target="_blank"><i class="bi bi-instagram"></i></a>
                        <a href="https://www.youtube.com/" target="_blank"><i class="bi bi-facebook"></i></a>
                    </div>
                </div>
                <div class="col-md-4">
                    <h5>Categorías</h5>
                    <div class="row">
                        <div class="col-6">
                            <ul>
                                <li><a href="#">INICIO</a></li>
                                <li><a href="#">SANTA SEDE</a></li>
                                <li><a href="#">FORMACIÓN</a></li>
                                <li><a href="#">LITURGIA</a></li>
                            </ul>
                        </div>
                        <div class="col-6">
                            <ul>
                                <li><a href="#">BIBLIA</a></li>
                                <li><a href="#">TEOLOGIA</a></li>
                                <li><a href="#">SANTOS</a></li>
                                <li><a href="#">REFLEXIONES</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <h5>Contacto</h5>
                    <ul>
                        <li><i class="bi bi-envelope-fill"></i> misacordero252@gmail.com</li>
                        <li><i class="bi bi-geo-alt-fill"></i> Cd. del Carmen</li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <script>
        import '../scripts/date.ts';
    </script>
</BaseLayout>