---
import { CATEGORY_LABELS, getSlug } from '../lib/categories';

const currentPath = Astro.url.pathname;
---
<nav class="nav-cats" id="nav-cats">
    <div class="container">
        <button id="nav-toggle" class="nav-toggle" aria-label="Abrir menú" aria-expanded="false">
            <i class="bi bi-list"></i> <span>CATEGORÍAS</span>
        </button>
        <ul>
            <li><a href="/" class={currentPath === '/' ? 'active' : ''}>INICIO</a></li>
            {CATEGORY_LABELS.map((label) => {
                const href = `/categorias/${getSlug(label)}/`;
                return (
                    <li><a href={href} class={currentPath === href ? 'active' : ''}>{label}</a></li>
                );
            })}
        </ul>
    </div>
</nav>