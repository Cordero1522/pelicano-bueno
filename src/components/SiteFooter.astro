---
import { CATEGORY_LABELS, getSlug } from '../lib/categories';

const mitad = Math.ceil(CATEGORY_LABELS.length / 2);
const columnaIzquierda = CATEGORY_LABELS.slice(0, mitad);
const columnaDerecha = CATEGORY_LABELS.slice(mitad);
---
<footer class="footer">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <h5>Pelícano Bueno</h5>
                <p style="font-size:0.9rem;">Este es un sitio católico independiente, creado para ofrecer recursos que ayuden a conocer, profundizar y vivir la fe.</p>
                <div class="social-icons">
                    <a href="https://x.com/?lang=es" target="_blank"><i class="bi bi-twitter-x"></i></a>
                    <a href="https://www.instagram.com/" target="_blank"><i class="bi bi-instagram"></i></a>
                    <a href="https://www.youtube.com/" target="_blank"><i class="bi bi-facebook"></i></a>
                </div>
            </div>
            <div class="col-md-4">
                <h5>Categorías</h5>
                <div class="row">
                    <div class="col-6">
                        <ul>
                            <li><a href="/">INICIO</a></li>
                            {columnaIzquierda.map((label) => (
                                <li><a href={`/categorias/${getSlug(label)}/`}>{label}</a></li>
                            ))}
                        </ul>
                    </div>
                    <div class="col-6">
                        <ul>
                            {columnaDerecha.map((label) => (
                                <li><a href={`/categorias/${getSlug(label)}/`}>{label}</a></li>
                            ))}
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <h5>Contacto</h5>
                <ul>
                    <li><i class="bi bi-envelope-fill"></i> misacordero252@gmail.com</li>
                    <li><i class="bi bi-geo-alt-fill"></i> Cd. del Carmen</li>
                </ul>
            </div>
        </div>
    </div>
</footer>